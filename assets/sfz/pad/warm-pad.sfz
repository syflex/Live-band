// LiveBand warm pad: sfizz oscillators, no samples (AGPLv3, part of this repository).
// Generated by tools/python/make_band_kits.py; edit that script, not this file.

<global>
pitch_keycenter=60
ampeg_attack=0.7
ampeg_sustain=100
ampeg_release=1.2
lokey=0
hikey=127

// Three detuned saws, softened by a low-pass filter.
<region>
sample=*saw
oscillator_multi=3
oscillator_detune=18
fil_type=lpf_2p
cutoff=1100
resonance=0.6
volume=-16.5
