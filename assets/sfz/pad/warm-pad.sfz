// LiveBand warm pad: sfizz oscillators, no samples (AGPLv3, part of this repository).
// Generated by tools/python/make_band_kits.py; edit that script, not this file.

<global>
pitch_keycenter=60
ampeg_attack=0.7
ampeg_sustain=100
ampeg_release=1.8
lokey=0
hikey=127

// Five detuned saws, softened by a low-pass filter.
<region>
sample=*saw
oscillator_multi=5
oscillator_detune=16
fil_type=lpf_2p
cutoff=1100
resonance=0.6
volume=-24

// A triangle an octave down for warmth.
<region>
sample=*triangle
transpose=-12
volume=-20
