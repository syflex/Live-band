// LiveBand synth bass: sfizz oscillators, no samples (AGPLv3, part of this repository).
// Generated by tools/python/make_band_kits.py; edit that script, not this file.

<global>
pitch_keycenter=60
ampeg_attack=0.002
ampeg_decay=0.9
ampeg_sustain=55
ampeg_release=0.07
lokey=0
hikey=127

// The body: a pure sine at the note's pitch.
<region>
sample=*sine
volume=-6

// The attack and growl: a saw through a low-pass filter that opens on each note.
<region>
sample=*saw
volume=-17
fil_type=lpf_2p
cutoff=280
resonance=3
fileg_attack=0.001
fileg_decay=0.18
fileg_sustain=15
fileg_depth=2200
